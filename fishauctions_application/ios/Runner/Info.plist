<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: the app uses only standard/exempt encryption (HTTPS
	     to the backend, OS keychain). Declaring this false lets every TestFlight
	     and App Store build skip the manual encryption question that otherwise
	     blocks each upload from distribution. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- BLE thermal label printing (flutter_blue_plus). Shown when the app first
	     uses Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<!-- Three real uses, all listed because Apple requires the string to describe
	     what the app actually does with the camera: native lot scanning (ARKit +
	     Vision read the QR codes on lot labels), the web check-in barcode scanner
	     (getUserMedia), and photo capture for the web's lot-image uploads. -->
	<key>NSCameraUsageDescription</key>
	<string>Read lot labels to identify and find lots, scan check-in barcodes, and take photos of your lots.</string>
	<!-- ARKit + sensors_plus (lot scanning): gravity, gyro and visual-inertial
	     tracking steady the scan overlay and keep the "find this lot" arrow
	     pointed the right way while you turn. Without this key iOS kills the app
	     on first motion access. -->
	<key>NSMotionUsageDescription</key>
	<string>Keep lot scanning steady and point you toward the lot you're looking for.</string>
	<!-- WebView photo-library uploads: lot images and club icons. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach photos from your library to your lots and club profile.</string>
	<!-- Native "add to calendar" bridge for auction pickup times.
	     NSCalendarsUsageDescription covers iOS 16; the WriteOnly/FullAccess
	     keys are the iOS 17+ replacements. -->
	<key>NSCalendarsUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<!-- Every use of location, in the order the user meets them: distances on the
	     auction/lot listings (soft, contextual banner — never at app open),
	     arriving at an in-person auction (CheckinService reports the position so
	     the server can welcome you / check you in, and lets an auction admin pin
	     the venue's location from their phone), and Square's card-present fraud
	     signal during a Tap to Pay charge. Prompted contextually: from the
	     listings banner, or on entering lot scanning. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Show the distance to auctions near you, check you in when you arrive at an in-person auction, and confirm where Tap to Pay charges happen.</string>
	<!-- The app never requests Always authorization — CheckinService and the
	     auction-distance banner are both when-in-use only, and nothing runs in
	     the background. This key is here because App Store Connect scans for API
	     *references*, not calls, and geolocator/Square link against the
	     always-authorization APIs: ITMS-90683 on build 8 asked for it by name.
	     Same string as above, since an escalation the app can't trigger has
	     nothing extra to explain. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Show the distance to auctions near you, check you in when you arrive at an in-person auction, and confirm where Tap to Pay charges happen.</string>
	<!-- FCM data messages while backgrounded: without this, iOS only wakes the
	     app for the display half of the backend's notification+data payload and
	     the background handler never runs. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>auction.fish</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>fishauctions_application</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Native Google sign-in (google_sign_in). Two values, both necessarily
	     static — unlike serverClientId, which SocialAuthService reads from
	     /api/mobile/config/ so one binary serves any deployment:

	       GIDClientID        the *iOS* OAuth client (Google Cloud console →
	                          Credentials → OAuth client ID → iOS, bundle id
	                          com.fishauctions.app), in the same Cloud project
	                          as the web client whose id the backend sends —
	                          the ID token's audience has to line up.
	       CFBundleURLSchemes the same id with the domain reversed. The OS
	                          resolves this at install time to route the OAuth
	                          callback back into the app, so it could never be
	                          runtime config; GIDClientID is kept alongside it
	                          rather than split across two mechanisms, since a
	                          fork has to edit this file either way.

	     A fork pointing at its own deployment replaces both strings. Callback
	     delivery goes through scene(_:openURLContexts:) under Flutter 3.44's
	     SceneDelegate, not application(_:open:options:) — see IOS.md. -->
	<key>GIDClientID</key>
	<string>1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
