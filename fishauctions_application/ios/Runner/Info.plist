<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: the app uses only standard/exempt encryption (HTTPS
	     to the backend, OS keychain). Declaring this false lets every TestFlight
	     and App Store build skip the manual encryption question that otherwise
	     blocks each upload from distribution. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- BLE thermal label printing (flutter_blue_plus). Shown when the app first
	     uses Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<!-- Three real uses, all listed because Apple requires the string to describe
	     what the app actually does with the camera: native lot scanning (ARKit +
	     Vision read the QR codes on lot labels), the web check-in barcode scanner
	     (getUserMedia), and photo capture for the web's lot-image uploads. -->
	<key>NSCameraUsageDescription</key>
	<string>Read lot labels to identify and find lots, scan check-in barcodes, and take photos of your lots.</string>
	<!-- ARKit + sensors_plus (lot scanning): gravity, gyro and visual-inertial
	     tracking steady the scan overlay and keep the "find this lot" arrow
	     pointed the right way while you turn. Without this key iOS kills the app
	     on first motion access. -->
	<key>NSMotionUsageDescription</key>
	<string>Keep lot scanning steady and point you toward the lot you're looking for.</string>
	<!-- WebView photo-library uploads: lot images and club icons. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach photos from your library to your lots and club profile.</string>
	<!-- Voice-driven set winners (VOICE.md). These are two SEPARATE iOS
	     prompts and both are mandatory: SFSpeechRecognizer traps on first use
	     without NSSpeechRecognitionUsageDescription even when the microphone
	     key is present. Recognition prefers on-device, so most sessions never
	     leave the phone — the wording says "may be sent" rather than promising
	     either way, because the fallback to Apple's servers is real when a
	     device has no on-device model for the locale. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Call out lot numbers, bidder numbers and prices to record sales hands-free while you run an auction.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into lot numbers, bidder numbers and prices on the set winners page. Speech is processed on this device when possible, and may be sent to Apple otherwise.</string>
	<!-- Native "add to calendar" bridge for auction pickup times.
	     NSCalendarsUsageDescription covers iOS 16; the WriteOnly/FullAccess
	     keys are the iOS 17+ replacements. -->
	<key>NSCalendarsUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<!-- Every use of location, in the order the user meets them: distances on the
	     auction/lot listings (soft, contextual banner — never at app open),
	     arriving at an in-person auction (CheckinService reports the position so
	     the server can welcome you / check you in, and lets an auction admin pin
	     the venue's location from their phone), and Square's card-present fraud
	     signal during a Tap to Pay charge. Prompted contextually: from the
	     listings banner, or on entering lot scanning. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Show the distance to auctions near you, check you in when you arrive at an in-person auction, and confirm where Tap to Pay charges happen.</string>
	<!-- The app never requests Always authorization — CheckinService and the
	     auction-distance banner are both when-in-use only, and nothing runs in
	     the background. This key is here because App Store Connect scans for API
	     *references*, not calls, and geolocator/Square link against the
	     always-authorization APIs: ITMS-90683 on build 8 asked for it by name.
	     Same string as above, since an escalation the app can't trigger has
	     nothing extra to explain. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Show the distance to auctions near you, check you in when you arrive at an in-person auction, and confirm where Tap to Pay charges happen.</string>
	<!-- FCM data messages while backgrounded: without this, iOS only wakes the
	     app for the display half of the backend's notification+data payload and
	     the background handler never runs. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>auction.fish</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>fishauctions_application</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Native Google sign-in (google_sign_in). Two values, both necessarily
	     static — unlike serverClientId, which SocialAuthService reads from
	     /api/mobile/config/ so one binary serves any deployment:

	       GIDClientID        the *iOS* OAuth client (Google Cloud console →
	                          Credentials → OAuth client ID → iOS, bundle id
	                          com.fishauctions.app), in the same Cloud project
	                          as the web client whose id the backend sends —
	                          the ID token's audience has to line up.
	       CFBundleURLSchemes the same id with the domain reversed. The OS
	                          resolves this at install time to route the OAuth
	                          callback back into the app, so it could never be
	                          runtime config; GIDClientID is kept alongside it
	                          rather than split across two mechanisms, since a
	                          fork has to edit this file either way.

	     A fork pointing at its own deployment replaces both strings. Callback
	     delivery goes through scene(_:openURLContexts:) under Flutter 3.44's
	     SceneDelegate, not application(_:open:options:) — see IOS.md. -->
	<key>GIDClientID</key>
	<string>1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g</string>
			</array>
		</dict>
		<!-- No Facebook entry here, and nothing should add one back: Facebook
		     login was removed outright (2026-08-10), because Facebook doesn't
		     verify the email addresses it hands over and an unverified address
		     can't be trusted to identify an account.

		     It's called out rather than just deleted because the empty version
		     of it is what rejected version 2026.8.10 build 11. Plist
		     substitution has no conditional, so `fb$(FACEBOOK_APP_ID)` with an
		     unset id expanded to the literal, reserved scheme `fb`:

		         ITMS-90155: The following URL schemes found in your app are
		         disallowed: [fb]

		     Worth knowing how that failure presents, since it isn't obvious: the
		     upload SUCCEEDS and CI goes green, then the binary is rejected
		     during processing and the news arrives by email. Meanwhile the
		     workflow's wait-for-processing step keeps polling for a VALID state
		     that will never come, outlives its 20-minute App Store Connect JWT,
		     and fails with a thoroughly misleading `401 NOT_AUTHORIZED`. A 401
		     from that step means "go read the ITMS email", not "the API key is
		     bad". -->
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Opt in to Flutter's own deep-link handling, so an iOS Universal Link
	     reaches the Dart router (config/router.dart hands any site path to the
	     WebView shell) instead of merely foregrounding the app. Harmless on its
	     own: without the associated-domains entitlement no universal link is
	     ever delivered, and the value only changes what happens to one that is.

	     Universal Links are OFF on purpose, the same product decision as the
	     commented-out App Links filter in AndroidManifest.xml: claiming the
	     domain takes auction.fish links away from the browser for everyone
	     with the app installed. The missing half is
	     `com.apple.developer.associated-domains` with `applinks:auction.fish`
	     in Runner.entitlements (and `applinks:staging.auction.fish` for the
	     staging build).

	     THE ORDER IS NOT REVERSIBLE FROM HERE, so when it is switched on:
	       1. Enable Associated Domains on the App ID in Certificates,
	          Identifiers and Profiles. Like Sign in with Apple this is
	          self-serve, but it must exist on the App ID *first* or cloud
	          signing cannot build a profile that carries the entitlement and
	          every Release / TestFlight export fails, exactly the way adding
	          the Tap to Pay entitlement early did.
	       2. Set IOS_APP_LINKS on the deployment ("TEAMID.bundle.id", comma
	          separated) so /.well-known/apple-app-site-association actually
	          serves. Unconfigured is a 404 by design, and Apple caches what it
	          fetches, so serving the file before the entitlement exists is the
	          cheap order.
	       3. Only then add the entitlement key to Runner.entitlements. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
