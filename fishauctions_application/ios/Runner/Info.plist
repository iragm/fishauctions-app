<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: the app uses only standard/exempt encryption (HTTPS
	     to the backend, OS keychain). Declaring this false lets every TestFlight
	     and App Store build skip the manual encryption question that otherwise
	     blocks each upload from distribution. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- BLE thermal label printing (flutter_blue_plus). Shown when the app first
	     uses Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Connect to your label printer to print lot labels.</string>
	<!-- WebView camera: the barcode check-in scanner (getUserMedia) and photo
	     capture for the web's image uploads. -->
	<key>NSCameraUsageDescription</key>
	<string>Scan check-in barcodes and lot labels, and take photos of your lots.</string>
	<!-- sensors_plus (AR lot mode): gravity/gyro steady the scan overlay and
	     keep directions pointed the right way while you turn. Without this
	     key iOS kills the app on first motion access. -->
	<key>NSMotionUsageDescription</key>
	<string>Keep AR lot scanning steady and pointed the right way.</string>
	<!-- WebView photo-library uploads: add-image-to-lot and club icon. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach photos from your library to your lots.</string>
	<!-- Native "add to calendar" bridge for auction pickup times.
	     NSCalendarsUsageDescription covers iOS 16; the WriteOnly/FullAccess
	     keys are the iOS 17+ replacements. -->
	<key>NSCalendarsUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Add auction pickup times to your calendar.</string>
	<!-- Distances to auctions on the listings pages (soft, contextual prompt —
	     never at app open), and required by Square during a Tap to Pay charge
	     (card-present fraud signal). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Show the distance to each auction, and confirm where Tap to Pay charges happen.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>auction.fish</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>fishauctions_application</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Native Google sign-in (google_sign_in). Two values, both necessarily
	     static — unlike serverClientId, which SocialAuthService reads from
	     /api/mobile/config/ so one binary serves any deployment:

	       GIDClientID        the *iOS* OAuth client (Google Cloud console →
	                          Credentials → OAuth client ID → iOS, bundle id
	                          com.fishauctions.app), in the same Cloud project
	                          as the web client whose id the backend sends —
	                          the ID token's audience has to line up.
	       CFBundleURLSchemes the same id with the domain reversed. The OS
	                          resolves this at install time to route the OAuth
	                          callback back into the app, so it could never be
	                          runtime config; GIDClientID is kept alongside it
	                          rather than split across two mechanisms, since a
	                          fork has to edit this file either way.

	     A fork pointing at its own deployment replaces both strings. Callback
	     delivery goes through scene(_:openURLContexts:) under Flutter 3.44's
	     SceneDelegate, not application(_:open:options:) — see IOS.md. -->
	<key>GIDClientID</key>
	<string>1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1028419796918-0glbi1lhnfk32pg60v57lmv0qc6nv90g</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
