<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds only (a `flutter run` from a Mac, which nobody can do yet).
	     Sandbox APNs, because a development-signed build gets sandbox tokens.
	     Release/Profile use Runner.entitlements. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
