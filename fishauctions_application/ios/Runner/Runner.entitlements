<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release/Profile builds are TestFlight and App Store builds, whose device
	     tokens are production APNs tokens — so this says production rather than
	     the `development` Xcode would write. Xcode's app-store export is
	     supposed to rewrite this itself, but a wrong value here fails silently:
	     tokens register against the sandbox, Firebase sends to production, and
	     nothing arrives with no error anywhere. Being explicit costs one line.
	     Debug builds get RunnerDebug.entitlements instead.

	     Tap to Pay's com.apple.developer.proximity-reader.payment.acceptance
	     goes here too — but only AFTER Apple grants it. Adding it early means
	     cloud signing can't build a profile that carries it and every export
	     fails. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Sign in with Apple. Required by App Review guideline 4.8 because the app
	     also offers Google login: wherever a third-party service sets up the
	     primary account, an equivalent privacy-preserving option must be
	     offered too. (Facebook login was offered here as well until 2026-08-10;
	     dropping it changes nothing for 4.8, since Google alone still triggers
	     the requirement.)

	     Unlike the Tap to Pay entitlement above, this one is self-serve — toggle
	     "Sign In with Apple" on the App ID in Certificates, Identifiers &
	     Profiles and regenerate the profile. It is NOT an Apple approval
	     process. But the profile still has to carry it: if the capability isn't
	     enabled on the App ID, every signed build fails with a provisioning
	     error, so enable it before the next release build. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Square Mobile Payments SDK: App Attest + NFC Tag Reading, the two
	     capabilities beside Tap to Pay that Square's iOS setup requires. App
	     Attest is what proves the application signature registered in Square's
	     Developer Console (bundle id + team id), without which Square silently
	     refuses to arm the reader — see the long note in
	     RunnerDebug.entitlements for how that failure presents.

	     Both are self-serve on the App ID and apply to development and
	     distribution profiles alike, so unlike the Tap to Pay key they belong
	     in BOTH files: a TestFlight or App Store build takes production
	     payments too, and would hit exactly the same wall without them. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>
</dict>
</plist>
