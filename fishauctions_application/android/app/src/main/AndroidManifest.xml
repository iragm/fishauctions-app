<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Bluetooth Low Energy for thermal label printing (iOS + Android) -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- Location — two independent uses, so these are NOT capped by
         maxSdkVersion:
         1. Geolocator reads the device position to set latitude/longitude
            cookies for the WebView (auction/lot distances). Needed at runtime
            on every API level.
         2. Classic-BT discovery on Android < 12 also needs location; on 12+ we
            use BLUETOOTH_SCAN with neverForLocation instead (declared above). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- NFC — Square Tap to Pay -->
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>
    <uses-permission android:name="android.permission.NFC"/>

    <!-- ARCore — AR lot mode's camera pipeline (BACKEND_SPEC.md Part 5,
         odo_x_m/odo_y_m): visual-inertial pose tracking replaces the old
         pedometer-based stride counting. Not required, so the app still
         installs on devices without Play Services for AR — AR lot mode itself
         degrades to an explainer screen there (ar/ArSessionManager.kt). The
         matching com.google.ar.core meta-data lives inside <application>
         below, where meta-data is actually valid. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false"/>

    <!-- Camera — the web check-in screen scans barcodes via the browser camera
         (getUserMedia) inside the WebView. The system WebView denies that
         request unless we both hold this runtime permission and grant the
         WebView's request; the bridging lives in WebViewScreen. Camera is
         optional so the app still installs on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Microphone — voice-driven set winners (VOICE.md). Speech recognition
         runs natively because iOS WKWebView has no Web Speech API and the shell
         denies the WebView's own microphone request; the page drives it over
         the voice* JS bridge. Optional feature so the app still installs on
         devices without a mic; the permission is asked when the operator taps
         the page's microphone button, never at launch. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Photo library — the web's image uploads (add-image-to-lot, club icon)
         are plain <input type="file" accept="image/*">. The file chooser the
         WebView opens reads images from the gallery; CAMERA (above) covers
         capture. Split by API level: scoped photo access on 33+, legacy read on
         32 and below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- android:label is the launcher/brand name. Keep it in sync with
         AppConstants.appName (native code can't read the Dart constant). -->
    <application
        android:label="auction.fish"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"><!--
        allowBackup/fullBackupContent disabled and dataExtractionRules set so
        Auto Backup / device-transfer never captures the flutter_secure_storage
        blob. Its key lives in the Android KeyStore (never backed up), so a
        restored blob would be undecryptable and could crash on read. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Android App Links are DELIBERATELY OFF. The filter below is
                 commented out, not deleted: claiming the domain means a tapped
                 auction.fish link stops opening in the browser for everyone
                 with the app installed, and that is a product decision — do we
                 pull people into the app? — that has been answered "not yet".

                 It was left in place and inert for a while on the theory that
                 an unverified filter costs nothing. It does cost something:
                 Play Console runs its own domain check on every autoVerify'd
                 web link and reports the deployment's empty assetlinks.json as
                 "1 issue found — failed domain checks" on the Deep links page,
                 forever, for a feature nobody is shipping. An unverified https
                 VIEW filter is also worse than none in the OS: instead of
                 opening the link, Android offers a chooser between the app and
                 the browser.

                 To turn it on, in this order:
                   1. Set ANDROID_APP_LINKS on the deployment
                      ("package=SHA256_FINGERPRINT", comma separated; repeat a
                      package for more fingerprints) so
                      https://<host>/.well-known/assetlinks.json serves real
                      statements — unconfigured is a 404 by design. The
                      fingerprint must be the certificate Google Play
                      *re-signs* with (Play Console → Release → Setup → App
                      signing → "App signing key certificate"), NOT the upload
                      key; using the upload key is the classic failure and it
                      fails silently. A debug-signed dev build has a different
                      fingerprint again, so add an entry per (applicationId,
                      fingerprint) pair you actually want to work.
                   2. Uncomment the filter. ${appLinkHost} is set per product
                      flavor in build.gradle.kts and must match the backend the
                      same FLAVOR dart-define points Dart at (prod →
                      auction.fish, dev/staging → staging.auction.fish).
                   3. Verify: adb shell pm get-app-links com.fishauctions.app
                 The Dart half (DeepLinkService, the router's redirect) is
                 already in place and needs no change.

                 Whenever it comes back, this stays the ONLY link type the app
                 claims. There is deliberately no filter for the
                 `fishauctions://` scheme: those links only ever appear inside
                 our own pages and are intercepted by the WebView's
                 shouldOverrideUrlLoading, so registering the scheme with the
                 OS would let any app — or any web page in any browser — drive
                 the shell's native flows.

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${appLinkHost}"/>
            </intent-filter>
            -->

            <!-- Opt in to Flutter's own deep-link handling, which is what
                 would turn the intent filter above into a route the Dart side
                 sees. Off by default on Android; without it the intent
                 launches the app and the URL is dropped on the floor, which is
                 worse than not claiming the link at all. Left enabled while
                 the filter is commented out — with no VIEW filter no URL ever
                 arrives, so it is inert, and it is one less thing to remember
                 on the day the filter comes back. The route lands in
                 go_router, whose redirect hands any site-shaped path to the
                 WebView shell (config/router.dart). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Push notification appearance. Android draws a notification icon as a
             *mask* — every non-transparent pixel is filled with the tint colour —
             so ic_notification is a white-on-transparent fish silhouette, not the
             launcher artwork. Without this meta-data FCM falls back to the
             launcher icon, which is opaque and renders as a white square.
             Applies only to the notification block the OS displays itself
             (background/terminated); foreground messages are drawn in-app as a
             SnackBar by webview_screen.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- ARCore dependency type. MUST be inside <application> — meta-data is
             invalid at manifest root, where it's silently dropped from the
             merged manifest and Google Play then rejects the bundle with "The
             ARCore dependency type 'com.google.ar.core' is missing from the
             AndroidManifest.xml file although the meta-data tag
             'com.google.ar.core.min_apk_version' has been specified" (that
             min_apk_version tag is merged in by the ARCore AAR itself, so
             once the dependency exists this tag is mandatory).
             "optional" pairs with the android.hardware.camera.ar uses-feature
             above: installable everywhere, and ArSessionManager checks
             ArCoreApk availability / requests install at runtime. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- Required by flutter_inappwebview's WebChromeClient for the
             <input type="file"> camera-capture path: it saves the photo via
             FileProvider.getUriForFile(context, "${applicationId}.flutter_inappwebview_android.fileprovider", file)
             before handing the browser a Uri. Without this provider declared,
             that call throws (swallowed by the plugin), so the photo is taken
             but never returned to the form's file callback. Authority string
             and file layout must match InAppWebViewFileProvider exactly. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.flutter_inappwebview_android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility for speech recognition. Without
             this, SpeechRecognizer.isRecognitionAvailable() returns false on
             API 30+ even when a recognition service is installed — the query
             is filtered out, so voice set-winners would silently report
             "not supported" on every modern phone. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
